# ──────────────────────────────────────────────────────────────
# ALIYDA FINANCIAL FRONTEND CONFIGURATION
# Copy this file to .env and fill in your Supabase details
# ──────────────────────────────────────────────────────────────

# Vite API Base URL (FastAPI backend local or hosted URL)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase Auth configuration (must match backend Supabase instance)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
