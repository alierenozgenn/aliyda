# ──────────────────────────────────────────────────────────────
# ALIYDA FINANCIAL BACKEND CONFIGURATION
# Copy this file to .env and fill in your Supabase & Gemini keys
# ──────────────────────────────────────────────────────────────

# Supabase Settings
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gemini AI Settings
GOOGLE_API_KEY=your-google-ai-api-key
# GEMINI_API_KEY is still accepted as a legacy alias.
GEMINI_API_KEY=
GEMINI_MODEL_EXTRACTION=gemini-3.1-flash-lite
GEMINI_MODEL_CHAT=gemini-3.1-flash-lite

# General settings
PORT=8000
HOST=0.0.0.0
